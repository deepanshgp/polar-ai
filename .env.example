# ═══════════════════════════════════════════════════════════════════════════════
# POLAR-AI v2 — Environment Variables
# Copy to .env and fill in values.
# The application runs in LIVE mode by default.
# Free sources (weather, ocean, icebergs, sea ice) work without any credentials.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=production
DEBUG=false
SECRET_KEY=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://polarai:polarai_password@localhost:5432/polarai_db
POSTGRES_USER=polarai
POSTGRES_PASSWORD=polarai_password
POSTGRES_DB=polarai_db

# ── Data Mode ─────────────────────────────────────────────────────────────────
# live  → real data; shows OFFLINE when source unavailable (DEFAULT — recommended)
# demo  → synthetic seed=42 data for testing only
# auto  → same as live
DATA_MODE=live

# ── Hourly Update Schedule ────────────────────────────────────────────────────
# How often (in minutes) to check all sources for new data
UPDATE_INTERVAL_MINUTES=60
SCHEDULER_ENABLED=true

# ── LLM (all optional — app works without them) ───────────────────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# ═══════════════════════════════════════════════════════════════════════════════
# EXTERNAL DATA SOURCES
# The sources below are FREE and work without any credentials:
#   - NSIDC Sea Ice Index (daily extent CSV)
#   - US National Ice Center Icebergs (weekly CSV)
#   - Open-Meteo NWP Weather (real NWP model, hourly)
#   - Open-Meteo Marine Ocean (wave + current model, hourly)
#
# The sources below require free registration:
# ═══════════════════════════════════════════════════════════════════════════════

# ── Copernicus Data Space (Sentinel-1 SAR satellite imagery) ──────────────────
# Register FREE at: https://dataspace.copernicus.eu/
# Without these: satellite layer shows "NOT CONNECTED"
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# ── AIS Vessel Tracking ───────────────────────────────────────────────────────
# Without AIS credentials: vessel layer shows "AIS NOT CONNECTED" (no fake position)
#
# Option A — AISStream.io (free tier, WebSocket, global coverage including Antarctica)
#   Register at: https://aisstream.io/
#   AIS_PROVIDER=aisstream
#   AIS_WS_URL=wss://stream.aisstream.io/v0/stream
#
# Option B — BarentsWatch (free, REST, strong Arctic/Antarctic coverage)
#   Register at: https://www.barentswatch.no/bwapi/
#   AIS_PROVIDER=barentswatch
#   AIS_API_URL=https://live.ais.barentswatch.no/v1/
#
# Option C — Custom REST endpoint (any AIS provider)
#   AIS_PROVIDER=custom
#   AIS_API_URL=https://your-provider.com/api/vessels
#
AIS_PROVIDER=
AIS_API_KEY=
AIS_API_URL=
AIS_WS_URL=
AIS_VESSEL_MMSI=   # Optional: filter to a specific vessel MMSI

# ── NSIDC Earthdata (for gridded sea-ice NetCDF — optional upgrade) ───────────
# The free NSIDC daily CSV works without this.
# Only needed for full gridded concentration data (G02202 CDR).
# Register FREE at: https://urs.earthdata.nasa.gov/
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# ── Copernicus CDS (ERA5 weather reanalysis — optional upgrade) ───────────────
# Open-Meteo NWP is used by default (free, no credentials).
# ERA5 provides higher-quality historical reanalysis if needed.
# Register FREE at: https://cds.climate.copernicus.eu/
CDS_API_KEY=
CDS_API_URL=https://cds.climate.copernicus.eu/api/v2

# ── OSI SAF / Copernicus Marine gridded sea ice ──────────────────────────────
# Requires a Copernicus Marine account and product permissions.
OSI_SAF_PRODUCT_ID=
OSI_SAF_USERNAME=
OSI_SAF_PASSWORD=

# ── Copernicus Marine (CMEMS — optional upgrade for SST/currents) ─────────────
# Open-Meteo Marine is used by default (free, no credentials).
# CMEMS provides higher-resolution currents and SST if needed.
# Register FREE at: https://marine.copernicus.eu/
COPERNICUS_MARINE_USERNAME=
COPERNICUS_MARINE_PASSWORD=
COPERNICUS_MARINE_PRODUCT_ID=GLOBAL_ANALYSISFORECAST_PHY_001_024

# ── Weather fallback (if Open-Meteo is insufficient) ─────────────────────────
WEATHER_API_KEY=
WEATHER_API_URL=

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5373

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=POLAR-AI
